class estudiante:
    def __init__(self, nombre, edad, programa_academico, semestre):
        self.nombre = nombre
        self.edad = edad
        self.programa_academico = programa_academico
        self.semestre = semestre
        
    def describir(self):
        print ( f"Nombre:{self.nombre}") 
        print ( f"Edad: {self.edad}") 
        print (f"Programa: {self.programa_academico}")
        print (f"Semestre: {self. semestre}")


#probar
estudiante1 = estudiante("Laura", "20", "ingenieria informatica", "tercer semestre")
print(estudiante1.describir())